{
  "key": "api-spec-documentation",
  "name": "API Spec Documentation",
  "description": "Transforms OpenAPI specifications into collaborative, tabular documentation with inline commenting capabilities",
  "vendor": {
    "name": "API Documentation Tools",
    "url": "https://example.com"
  },
  "baseUrl": "{{localBaseUrl}}",
  "links": {
    "self": "{{localBaseUrl}}/atlassian-connect.json",
    "homepage": "{{localBaseUrl}}"
  },
  "authentication": {
    "type": "jwt"
  },
  "lifecycle": {
    "installed": "/installed"
  },
  "scopes": [
    "read",
    "write"
  ],
  "modules": {
    "dynamicContentMacros": [
      {
        "key": "api-spec-documentation-macro",
        "name": {
          "value": "API Spec Documentation"
        },
        "description": {
          "value": "Renders OpenAPI specifications in a tabular format"
        },
        "url": "/macro-view",
        "editor": {
          "url": "/macro-editor",
          "editTitle": {
            "value": "Edit API Spec Documentation"
          },
          "insertTitle": {
            "value": "Insert API Spec Documentation"
          },
          "width": "80%",
          "height": "80%"
        },
        "categories": [
          "visuals"
        ],
        "featured": true,
        "outputType": "block",
        "bodyType": "none",
        "parameters": [
          {
            "identifier": "spec",
            "name": {
              "value": "OpenAPI Specification"
            },
            "description": {
              "value": "JSON or YAML OpenAPI specification"
            },
            "type": "string",
            "multiple": false,
            "required": true
          },
          {
            "identifier": "format",
            "name": {
              "value": "Format"
            },
            "description": {
              "value": "Format of the specification (json or yaml)"
            },
            "type": "enum",
            "values": [
              "json",
              "yaml"
            ],
            "defaultValue": "json",
            "multiple": false,
            "required": true
          }
        ]
      }
    ]
  }
}
